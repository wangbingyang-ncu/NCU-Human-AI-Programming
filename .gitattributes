# ============================================================
#  .gitattributes —— 统一换行符，避免 Windows / Mac 协作时的格式冲突
# ============================================================

# 所有文本文件在仓库内统一存为 LF 换行
* text=auto eol=lf

# 明确按文本处理
*.py     text
*.md     text
*.txt    text
*.json   text
*.yml    text
*.yaml   text
*.html   text
*.css    text
*.js     text
*.svg    text

# 明确按二进制处理（不要改动其中的字节）
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.xlsx   binary
*.docx   binary
*.pptx   binary

# Windows 脚本保留 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# 让 GitHub 语言统计不把 HTML 算成主语言
*.html   linguist-documentation
